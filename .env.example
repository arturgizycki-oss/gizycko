# Copy to .env and fill in. Never commit .env itself.

# --- Database ---------------------------------------------------------------
# Local dev: run `npm run db` and paste the connection string it prints.
# Production: Supabase > Project settings > Database > Connection string.
#   Use the "Transaction pooler" URL (port 6543) and append ?pgbouncer=true.
#   A serverless function opens a connection per invocation; the pooler is what
#   stops that exhausting Postgres.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/gizycko?schema=public"

# Migrations need a direct connection: they take locks and run DDL, which a
# transaction pooler cannot carry. Supabase > Database > Connection string >
# "Direct connection" (port 5432). Leave empty locally.
DIRECT_URL=""

# Only needed to create migrations locally. Not used in production.
SHADOW_DATABASE_URL=""

# Set to 1 for the local `prisma dev` server, which tolerates one connection.
# Leave unset (defaults to 10) against real Postgres.
DATABASE_POOL_MAX=1

# --- Auth -------------------------------------------------------------------
# Generate with: openssl rand -hex 32
# Changing this signs everybody out.
BETTER_AUTH_SECRET="generate-with-openssl-rand-hex-32"

# The site's own address. Wrong values break sign-in and the links in emails.
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- File storage -----------------------------------------------------------
# "local" writes under STORAGE_DIR and is for development only: a serverless
# host throws that disk away between requests.
# "supabase" keeps uploads in a Supabase Storage bucket.
STORAGE_DRIVER="local"
STORAGE_DIR=".storage"

# Supabase > Project settings > API.
SUPABASE_URL=""
# The service role key, not the anon key. It bypasses row-level security, so
# the bucket can stay private. Server-side only - never expose it.
SUPABASE_SERVICE_ROLE_KEY=""
# Create this bucket in Supabase > Storage. Keep it private.
SUPABASE_STORAGE_BUCKET="media"

# --- Live updates -----------------------------------------------------------
# Optional. Without these the site polls instead, which works - it is just not
# instant. Nothing else changes.
#
# Both reach the browser, which is why they are the publishable key and not the
# service role one. What travels over this connection is only the word for what
# changed; the browser then fetches the thing itself through the application,
# where the usual permission checks apply. See src/lib/realtime.ts.
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# --- Email ------------------------------------------------------------------
# "log" prints messages to the server log, which is what development uses.
# "resend" sends them for real.
MAIL_DRIVER="log"
RESEND_API_KEY=""
# Must be an address on a domain verified in Resend.
MAIL_FROM="no-reply@gizycko.online"
