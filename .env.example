# --- Database ---
# Local dev: run `npx prisma dev` and paste the connection string it prints here.
# Production: use your Neon / Supabase / Prisma Postgres connection string.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/gizycko?schema=public"

# --- Auth ---
BETTER_AUTH_SECRET="generate-with-openssl-rand-hex-32"
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Set to 1 when using the local `prisma dev` server, which tolerates only one
# connection. Leave unset (defaults to 10) against real Postgres.
DATABASE_POOL_MAX=1
